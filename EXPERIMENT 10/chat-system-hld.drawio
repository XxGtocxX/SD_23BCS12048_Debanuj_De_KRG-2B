        <mxCell id="ce4" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="4. Queue" vertex="1"><mxGeometry height="22" width="100" x="80" y="180" as="geometry"/></mxCell>
        <mxCell id="ce5" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="5. Channel (Pub/Sub)" vertex="1"><mxGeometry height="22" width="150" x="80" y="202" as="geometry"/></mxCell>
        <mxCell id="ce6" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="6. DeliveryLog" vertex="1"><mxGeometry height="22" width="120" x="80" y="224" as="geometry"/></mxCell>
