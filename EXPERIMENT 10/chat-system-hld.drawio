<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="chat-system-hld">
    <mxGraphModel dx="3770" dy="1611" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════ TITLE ═══════ -->
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;strokeColor=none;fillColor=none;fontStyle=1;fontSize=17;" value="Aim: Design a Real-Time Chat System" vertex="1">
          <mxGeometry height="40" width="500" x="175" y="10" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;strokeColor=none;fillColor=none;fontSize=11;" value="Simulates how apps like WhatsApp / Slack deliver messages using Redis Queues, Pub/Sub, and Socket.IO" vertex="1">
          <mxGeometry height="25" width="640" x="55" y="48" as="geometry" />
        </mxCell>

        <mxCell id="div0" parent="1" style="endArrow=none;html=1;strokeWidth=5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-750" y="80" as="sourcePoint" />
            <mxPoint x="1600" y="80" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════
             A. FUNCTIONAL REQUIREMENTS
        ═══════════════════════════════════════ -->
        <mxCell id="a-hdr" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontStyle=1;fontSize=12;" value="A. Functional Requirements" vertex="1">
          <mxGeometry height="24" width="260" x="-750" y="88" as="geometry" />
        </mxCell>
        <mxCell id="fr1" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="1. Users should be able to join rooms (general, tech, etc.)" vertex="1"><mxGeometry height="22" width="480" x="-730" y="114" as="geometry"/></mxCell>
        <mxCell id="fr2" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="2. Users should be able to send messages to a room in real-time." vertex="1"><mxGeometry height="22" width="490" x="-730" y="136" as="geometry"/></mxCell>
        <mxCell id="fr3" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="3. All users in a room should receive the message instantly via Pub/Sub." vertex="1"><mxGeometry height="22" width="510" x="-730" y="158" as="geometry"/></mxCell>
        <mxCell id="fr4" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="4. System should maintain last 20 messages per room (chat history)." vertex="1"><mxGeometry height="22" width="490" x="-730" y="180" as="geometry"/></mxCell>
        <mxCell id="fr5" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="5. System should track online/offline status of users." vertex="1"><mxGeometry height="22" width="440" x="-730" y="202" as="geometry"/></mxCell>
        <mxCell id="fr6" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="6. System should track unread message count per user." vertex="1"><mxGeometry height="22" width="440" x="-730" y="224" as="geometry"/></mxCell>
        <mxCell id="fr7" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="7. Every message should be logged with sender, content, timestamp, status." vertex="1"><mxGeometry height="22" width="500" x="-730" y="246" as="geometry"/></mxCell>

        <!-- ═══════════════════════════════════════
             B. NON-FUNCTIONAL REQUIREMENTS
        ═══════════════════════════════════════ -->
        <mxCell id="b-hdr" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontStyle=1;fontSize=12;" value="B. Non-Functional Requirements" vertex="1">
          <mxGeometry height="24" width="280" x="-750" y="280" as="geometry" />
        </mxCell>
        <mxCell id="nfr1" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="1. Scale: Multiple users in multiple rooms simultaneously." vertex="1"><mxGeometry height="22" width="420" x="-730" y="306" as="geometry"/></mxCell>
        <mxCell id="nfr2a" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontStyle=1;fontSize=11;" value="2. CAP Theorem:" vertex="1"><mxGeometry height="22" width="130" x="-730" y="328" as="geometry"/></mxCell>
        <mxCell id="nfr2b" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="Availability &gt;&gt;&gt; Consistency   (slight delay acceptable, message loss is not)" vertex="1"><mxGeometry height="22" width="490" x="-600" y="328" as="geometry"/></mxCell>
        <mxCell id="nfr3" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="3. Latency: Message delivery &lt; 100ms via Redis Pub/Sub." vertex="1"><mxGeometry height="22" width="420" x="-730" y="350" as="geometry"/></mxCell>
        <mxCell id="nfr4" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="4. Concurrency: Each user runs a separate Pub/Sub listener thread (non-blocking)." vertex="1"><mxGeometry height="22" width="530" x="-730" y="372" as="geometry"/></mxCell>
        <mxCell id="nfr5" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;" value="5. Durability: Messages stored in Redis LIST before delivery (queue-first approach)." vertex="1"><mxGeometry height="22" width="530" x="-730" y="394" as="geometry"/></mxCell>

        <!-- ═══════════════════════════════════════
