        <!-- ═══ THREADS box ═══ -->
        <mxCell id="thread-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#005555;fontColor=#ffffff;strokeColor=#003333;fontStyle=1;fontSize=11;" value="Listener Threads&lt;div&gt;threading.Thread per user&lt;/div&gt;&lt;div&gt;_listen_pubsub()&lt;/div&gt;" vertex="1">
