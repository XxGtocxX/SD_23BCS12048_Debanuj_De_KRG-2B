        </mxCell>
        <mxCell id="thread-note" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=10;" value="- Each user has own thread&lt;br&gt;- Non-blocking system&lt;br&gt;- Simulates concurrent users" vertex="1">
          <mxGeometry height="48" width="200" x="-750" y="798" as="geometry" />
        </mxCell>

        <!-- threads ↔ pubsub -->
        <mxCell id="e-th-ps" parent="1" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#005555;strokeWidth=2;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-548" y="760" as="sourcePoint" />
            <mxPoint x="298" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════
             DIVIDER 2
        ═══════════════════════════════════════ -->
        <mxCell id="div2" parent="1" style="endArrow=none;html=1;strokeWidth=5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-750" y="880" as="sourcePoint" />
            <mxPoint x="1600" y="880" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════
             F. REDIS KEY DESIGN
        ═══════════════════════════════════════ -->
        <mxCell id="f-hdr" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontStyle=1;fontSize=12;" value="F. Redis Key Design (Why each structure was chosen)" vertex="1">
          <mxGeometry height="24" width="420" x="-750" y="888" as="geometry" />
        </mxCell>

        <mxCell id="rk1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#a30000;fontColor=#ffffff;strokeColor=#6b0000;fontStyle=1;fontSize=11;align=left;" value="  STRING  →  chat:user:{username}:status" vertex="1"><mxGeometry height="28" width="310" x="-750" y="916" as="geometry"/></mxCell>
        <mxCell id="rk1n" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=10;" value="Why STRING? Simple on/off value. TTL=30s auto-expires → user auto goes offline if no heartbeat." vertex="1"><mxGeometry height="18" width="500" x="-730" y="944" as="geometry"/></mxCell>

        <mxCell id="rk2" parent="1" style="whiteSpace=wrap;html=1;fillColor=#4a007a;fontColor=#ffffff;strokeColor=#2e0050;fontStyle=1;fontSize=11;align=left;" value="  SET  →  chat:room:{roomName}:users" vertex="1"><mxGeometry height="28" width="290" x="-750" y="968" as="geometry"/></mxCell>
        <mxCell id="rk2n" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=10;" value="Why SET? No duplicate users. O(1) add/remove. Perfect for room membership." vertex="1"><mxGeometry height="18" width="460" x="-730" y="996" as="geometry"/></mxCell>

        <mxCell id="rk3" parent="1" style="whiteSpace=wrap;html=1;fillColor=#a30000;fontColor=#ffffff;strokeColor=#6b0000;fontStyle=1;fontSize=11;align=left;" value="  LIST  →  chat:queue" vertex="1"><mxGeometry height="28" width="200" x="-750" y="1020" as="geometry"/></mxCell>
        <mxCell id="rk3n" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=10;" value="Why LIST? FIFO message queue. LPUSH to add, RPOP to consume. Decouples sender from receiver." vertex="1"><mxGeometry height="18" width="510" x="-730" y="1048" as="geometry"/></mxCell>

        <mxCell id="rk4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#a30000;fontColor=#ffffff;strokeColor=#6b0000;fontStyle=1;fontSize=11;align=left;" value="  LIST  →  chat:messages:{roomName}" vertex="1"><mxGeometry height="28" width="270" x="-750" y="1072" as="geometry"/></mxCell>
        <mxCell id="rk4n" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=10;" value="Why LIST? Ordered history. LRANGE 0 19 fetches last 20 messages instantly." vertex="1"><mxGeometry height="18" width="450" x="-730" y="1100" as="geometry"/></mxCell>

        <mxCell id="rk5" parent="1" style="whiteSpace=wrap;html=1;fillColor=#4a007a;fontColor=#ffffff;strokeColor=#2e0050;fontStyle=1;fontSize=11;align=left;" value="  HASH  →  chat:log:{message_id}" vertex="1"><mxGeometry height="28" width="270" x="-750" y="1124" as="geometry"/></mxCell>
        <mxCell id="rk5n" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=10;" value="Why HASH? Stores multiple fields per message (sender, content, timestamp, status) in one key." vertex="1"><mxGeometry height="18" width="520" x="-730" y="1152" as="geometry"/></mxCell>

        <mxCell id="rk6" parent="1" style="whiteSpace=wrap;html=1;fillColor=#a30000;fontColor=#ffffff;strokeColor=#6b0000;fontStyle=1;fontSize=11;align=left;" value="  PUB/SUB  →  channel: chat:{roomName}" vertex="1"><mxGeometry height="28" width="290" x="-750" y="1176" as="geometry"/></mxCell>
        <mxCell id="rk6n" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=10;" value="Why PUB/SUB? Instant broadcast to all subscribers. One publish reaches all users in a room." vertex="1"><mxGeometry height="18" width="510" x="-730" y="1204" as="geometry"/></mxCell>

        <mxCell id="rk7" parent="1" style="whiteSpace=wrap;html=1;fillColor=#a30000;fontColor=#ffffff;strokeColor=#6b0000;fontStyle=1;fontSize=11;align=left;" value="  STRING (INCR)  →  chat:unread:{username}" vertex="1"><mxGeometry height="28" width="300" x="-750" y="1228" as="geometry"/></mxCell>
        <mxCell id="rk7n" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=10;" value="Why INCR? Atomic counter. INCR on receive, SET 0 on read. No race conditions." vertex="1"><mxGeometry height="18" width="470" x="-730" y="1256" as="geometry"/></mxCell>

        <!-- ═══════════════════════════════════════
             G. LIMITATIONS
        ═══════════════════════════════════════ -->
        <mxCell id="g-hdr" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontStyle=1;fontSize=12;" value="G. Limitations (Scope for improvement)" vertex="1">
          <mxGeometry height="24" width="320" x="400" y="888" as="geometry" />
        </mxCell>

        <mxCell id="lim1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ff6666;strokeColor=#666666;align=left;fontSize=11;" value="  ✗  No authentication (username only, no password)" vertex="1"><mxGeometry height="28" width="380" x="400" y="916" as="geometry"/></mxCell>
        <mxCell id="lim2" parent="1" style="whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ff6666;strokeColor=#666666;align=left;fontSize=11;" value="  ✗  No persistent DB — only Redis (data lost on restart)" vertex="1"><mxGeometry height="28" width="380" x="400" y="948" as="geometry"/></mxCell>
        <mxCell id="lim3" parent="1" style="whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ff6666;strokeColor=#666666;align=left;fontSize=11;" value="  ✗  Single worker — not distributed" vertex="1"><mxGeometry height="28" width="380" x="400" y="980" as="geometry"/></mxCell>
        <mxCell id="lim4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ff6666;strokeColor=#666666;align=left;fontSize=11;" value="  ✗  No message retry mechanism (no DLQ)" vertex="1"><mxGeometry height="28" width="380" x="400" y="1012" as="geometry"/></mxCell>
        <mxCell id="lim5" parent="1" style="whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ff6666;strokeColor=#666666;align=left;fontSize=11;" value="  ✗  Terminal-based only (no UI / no browser)" vertex="1"><mxGeometry height="28" width="380" x="400" y="1044" as="geometry"/></mxCell>
        <mxCell id="lim6" parent="1" style="whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ff6666;strokeColor=#666666;align=left;fontSize=11;" value="  ✗  No horizontal scaling (single Redis instance)" vertex="1"><mxGeometry height="28" width="380" x="400" y="1076" as="geometry"/></mxCell>

        <!-- ═══════════════════════════════════════
             H. SD CONCEPTS COVERED
        ═══════════════════════════════════════ -->
        <mxCell id="h-hdr" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontStyle=1;fontSize=12;" value="H. System Design Concepts Demonstrated" vertex="1">
          <mxGeometry height="24" width="360" x="400" y="1118" as="geometry" />
        </mxCell>

        <mxCell id="c1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#1e6b1e;fontColor=#ffffff;strokeColor=#1a4a1a;align=left;fontSize=11;" value="  ✓  Message Queue System — decouples sender &amp; receiver" vertex="1"><mxGeometry height="28" width="400" x="400" y="1146" as="geometry"/></mxCell>
        <mxCell id="c2" parent="1" style="whiteSpace=wrap;html=1;fillColor=#1e6b1e;fontColor=#ffffff;strokeColor=#1a4a1a;align=left;fontSize=11;" value="  ✓  Event-Driven Architecture — Pub/Sub model" vertex="1"><mxGeometry height="28" width="400" x="400" y="1178" as="geometry"/></mxCell>
        <mxCell id="c3" parent="1" style="whiteSpace=wrap;html=1;fillColor=#1e6b1e;fontColor=#ffffff;strokeColor=#1a4a1a;align=left;fontSize=11;" value="  ✓  Scalability — Redis high throughput + async threads" vertex="1"><mxGeometry height="28" width="400" x="400" y="1210" as="geometry"/></mxCell>
        <mxCell id="c4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#1e6b1e;fontColor=#ffffff;strokeColor=#1a4a1a;align=left;fontSize=11;" value="  ✓  Fault Tolerance — messages stored before delivery" vertex="1"><mxGeometry height="28" width="400" x="400" y="1242" as="geometry"/></mxCell>
        <mxCell id="c5" parent="1" style="whiteSpace=wrap;html=1;fillColor=#1e6b1e;fontColor=#ffffff;strokeColor=#1a4a1a;align=left;fontSize=11;" value="  ✓  Data Modelling — correct Redis structure per use case" vertex="1"><mxGeometry height="28" width="400" x="400" y="1274" as="geometry"/></mxCell>
        <mxCell id="c6" parent="1" style="whiteSpace=wrap;html=1;fillColor=#1e6b1e;fontColor=#ffffff;strokeColor=#1a4a1a;align=left;fontSize=11;" value="  ✓  Concurrency — separate listener thread per user" vertex="1"><mxGeometry height="28" width="400" x="400" y="1306" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
